# Notifikácie z formulárov. Bez týchto premenných sa správy len logujú
# do konzoly a web funguje aj tak.
RESEND_API_KEY=
NOTIFY_EMAIL=info@pruud.sk
NOTIFY_FROM="PRUUD <noreply@pruud.sk>"

# Lokálna PGlite databáza. V produkcii nahradiť Postgres connection stringom.
PGLITE_DIR=./.pglite

# EDC / OKTE — doplniť až po podpise Zmluvy o poskytovaní údajov.
# Tokeny patria SEM, nikdy do kódu ani do gitu (.env*.local je v .gitignore).
EDC_API_URL=
EDC_API_TOKEN=

# Ukážkový režim overenia merania. Zapnúť LEN na demo, nikdy v produkcii —
# vracia vymyslený výsledok o priebehovom meraní.
PRUUD_DEMO_METERING=0
